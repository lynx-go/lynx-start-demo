# 环境变量前缀 LYNX_START_DEMO（cp 为 .env 后按需修改；config.yaml 同名键被覆盖）
# 本地 Postgres 宿主端口非 5432 时改 DSN 并导出 POSTGRES_PORT 供 compose 使用。
LYNX_START_DEMO_DATA_DATABASE_SOURCE=postgres://lynx_start_demo:lynx_start_demo@127.0.0.1:5432/lynx_start_demo?sslmode=disable

# module identity: 身份令牌签发主密钥 (secret — rotate for production)
LYNX_START_DEMO_IDENTITY_SECRET=ccd5281196c56f5a5242229c44cf4be9

# module session: 会话令牌主密钥（与 identity 独立） (secret — rotate for production)
LYNX_START_DEMO_SESSION_SECRET=23b31bc277fe77a433ec103c7c635b4f
